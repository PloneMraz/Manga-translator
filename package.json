{
  "name": "comic-translator",
  "private": true,
  "version": "0.1.0",
  "description": "On-device image translation for comics and manga.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:detector": "node tests/bubble-detector.mjs",
    "test:render": "node tests/render-page.mjs",
    "test": "npm run test:detector && npm run test:render && npm run test:app",
    "test:app": "node tests/app-flow.mjs",
    "sync:ort": "node scripts/sync-ort.mjs",
    "predev": "node scripts/sync-ort.mjs",
    "prebuild": "node scripts/sync-ort.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@huggingface/transformers": "^4.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
